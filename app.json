{
  "expo": {
    "name": "Indie",
    "slug": "indie",
    "version": "1.1.3",
    "orientation": "portrait",
    "icon": "./assets/indie_rem.png",
    "scheme": "me.ritom.indie",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "me.ritom.indie",
      "associatedDomains": [
        "applinks:indieapp.vercel.app"
      ],
      "infoPlist": {
        "NSUserTrackingUsageDescription": "Indie uses this to personalise your home feed and show you relevant creative content based on your interests. No data is sold to third parties.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "me.ritom.indie",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "com.google.android.gms.permission.AD_ID"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "indieapp.vercel.app"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Indie accesses your photos to let you create pins.",
          "cameraPermission": "Indie accesses your camera to let you create pins."
        }
      ],
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/indie.jpeg",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      "expo-tracking-transparency",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "61931d90-c63d-46a3-8b9e-13e2283aa2b2"
      }
    },
    "owner": "ritomg",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/61931d90-c63d-46a3-8b9e-13e2283aa2b2"
    }
  }
}
